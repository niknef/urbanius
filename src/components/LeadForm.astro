---
import { motivosConsulta } from '../data/site';

interface Props {
  /** 'full' = formulario de pie de página; 'compact' = panel flotante. */
  variant?: 'full' | 'compact';
  /** Prefijo de ids, para poder repetir el formulario en la misma página. */
  idPrefix?: string;
  /** Se envía junto al lead para saber desde dónde llegó. */
  origen: string;
}

const { variant = 'full', idPrefix = '', origen } = Astro.props;
const id = (name: string) => `${idPrefix}${name}`;
const compact = variant === 'compact';
---

<form
  class={`grid ${compact ? 'gap-3.5' : 'gap-4'}`}
  data-lead-form
  data-origen={origen}
  novalidate
>
  <div class={compact ? 'grid gap-3.5' : 'grid gap-4 sm:grid-cols-2'}>
    <div class="field">
      <label for={id('nombre')}>Nombre *</label>
      <input
        id={id('nombre')}
        name="nombre"
        type="text"
        autocomplete="name"
        placeholder="Su nombre"
        required
        minlength="2"
      />
      <span class="field-error">Ingrese su nombre.</span>
    </div>
    <div class="field">
      <label for={id('telefono')}>Teléfono *</label>
      <input
        id={id('telefono')}
        name="telefono"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder="+54 9 11 ..."
        required
        pattern="[0-9+()\s-]{6,}"
      />
      <span class="field-error">Ingrese un teléfono de contacto válido.</span>
    </div>
  </div>

  <div class="field">
    <label for={id('email')}>Email *</label>
    <input
      id={id('email')}
      name="email"
      type="email"
      autocomplete="email"
      placeholder="nombre@empresa.com"
      required
    />
    <span class="field-error">Ingrese un email válido.</span>
  </div>

  {
    !compact && (
      <div class="field">
        <label for={id('empresa')}>Empresa</label>
        <input
          id={id('empresa')}
          name="empresa"
          type="text"
          autocomplete="organization"
          placeholder="Razón social"
        />
      </div>
    )
  }

  <div class="field">
    <label for={id('motivo')}>¿Cuál es su motivo de consulta? *</label>
    <select id={id('motivo')} name="motivo" required>
      <option value="">Seleccionar...</option>
      {motivosConsulta.map((m) => <option value={m}>{m}</option>)}
    </select>
    <span class="field-error">Seleccione un motivo.</span>
  </div>

  {
    !compact && (
      <div class="field">
        <label for={id('comentarios')}>Comentarios</label>
        <textarea
          id={id('comentarios')}
          name="comentarios"
          rows="3"
          class="min-h-24 resize-y"
          placeholder="Cuéntenos brevemente su necesidad"
        />
      </div>
    )
  }

  {/* Honeypot anti-spam: invisible para personas, tentador para bots. */}
  <div class="absolute -left-[9999px] h-0 overflow-hidden" aria-hidden="true">
    <label for={id('web')}>No completar</label>
    <input id={id('web')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class={`btn btn-solid ${compact ? 'w-full' : 'justify-self-start'}`}>
    <span data-submit-label>Enviar consulta</span>
  </button>

  <p
    class="hidden rounded-brand border border-line bg-sky-50 px-3.5 py-3 text-[13px]"
    data-form-status
    role="status"
    aria-live="polite"
  >
  </p>

  <p class="text-[12px] text-ink-soft">
    Al enviar acepta que un asesor técnico se comunique por los datos provistos.
  </p>
</form>

<script>
  import { whatsappHref } from '../data/site';

  const ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;

  const messageFrom = (data: Record<string, string>) =>
    [
      'Consulta desde la web de URBANUS QHSE',
      `Nombre: ${data.nombre}`,
      `Teléfono: ${data.telefono}`,
      `Email: ${data.email}`,
      data.empresa && `Empresa: ${data.empresa}`,
      `Motivo: ${data.motivo}`,
      data.comentarios && `Comentarios: ${data.comentarios}`,
    ]
      .filter(Boolean)
      .join('\n');

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;

    const show = (text: string, kind: 'ok' | 'error') => {
      status.textContent = text;
      status.classList.remove('hidden');
      status.classList.toggle('border-blue-600', kind === 'ok');
      status.classList.toggle('text-navy-800', kind === 'ok');
      status.classList.toggle('border-red-300', kind === 'error');
      status.classList.toggle('bg-red-50', kind === 'error');
      status.classList.toggle('text-red-700', kind === 'error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      form.classList.add('was-submitted');

      if (!form.checkValidity()) {
        form.querySelector<HTMLInputElement>(':invalid')?.focus();
        show('Revise los campos marcados antes de enviar.', 'error');
        return;
      }

      const raw = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (raw.website) return; // honeypot: bot silencioso

      const payload = {
        ...raw,
        origen: form.dataset.origen ?? '',
        enviado: new Date().toISOString(),
        pagina: location.href,
      };
      delete (payload as Record<string, string>).website;

      // Sin endpoint configurado (lead destination pendiente), el formulario
      // deriva a WhatsApp con todos los datos precargados.
      if (!ENDPOINT) {
        window.open(whatsappHref(messageFrom(raw)), '_blank', 'noopener');
        show('Abrimos WhatsApp con su consulta lista para enviar.', 'ok');
        return;
      }

      button.disabled = true;
      button.classList.add('opacity-70');
      label.textContent = 'Enviando...';

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('was-submitted');
        show('¡Gracias! Recibimos su consulta y un asesor técnico se comunica a la brevedad.', 'ok');
      } catch {
        show('No pudimos enviar el formulario. Escríbanos por WhatsApp y lo resolvemos al toque.', 'error');
      } finally {
        button.disabled = false;
        button.classList.remove('opacity-70');
        label.textContent = 'Enviar consulta';
      }
    });
  });
</script>
