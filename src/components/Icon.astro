---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  'aria-hidden'?: boolean;
}

const { name, class: className = 'size-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
