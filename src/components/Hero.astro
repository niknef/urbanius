---
import { Image } from 'astro:assets';
import { site, stats, whatsappHref } from '../data/site';
import Icon from './Icon.astro';
import portada from '../assets/brand/portada.jpg';
import logo from '../assets/brand/logo-urbanus.png';
---

<section class="relative overflow-hidden bg-linear-to-b from-navy-800 to-navy-900 text-white">
  <div class="blueprint pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 -right-40 size-[520px] rounded-full bg-sky-400/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="wrap relative grid items-center gap-14 py-20 lg:grid-cols-[1.1fr_.9fr] lg:py-24"
    id="contenido"
  >
    <div>
      <span class="mb-5 flex items-center gap-2.5 text-[13px] font-semibold text-sky-400">
        <span class="h-px w-7 bg-sky-400"></span>
        Consultoría QHSE estratégica y operativa
      </span>

      <h1 class="max-w-xl text-[clamp(2rem,5vw,2.75rem)] leading-[1.12] font-bold text-white">
        Ingeniería preventiva para empresas e industrias de alta complejidad.
      </h1>

      <p class="mt-5 max-w-lg text-[17px] text-[#CFE3F0]">
        Acompañamos a organizaciones exigentes a mitigar riesgos, proteger a las personas y asegurar
        el cumplimiento legal, garantizando la continuidad del negocio.
      </p>

      <p class="mt-7 max-w-md border-l-2 border-sky-400 pl-4.5 text-[15.5px] text-[#B9D3E5]">
        Soluciones integrales de ingeniería preventiva y gestión normativo-operativa para empresas e
        industrias de alta complejidad.
      </p>

      <div class="mt-9 flex flex-wrap gap-3.5">
        <a href="#contacto-form" class="btn btn-primary">Solicitar consulta</a>
        <a href="#servicios" class="btn btn-outline">Ver módulos de servicio</a>
      </div>

      <p class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] text-[#8FAEC2]">
        <span class="inline-flex items-center gap-2">
          <Icon name="shield" class="size-4 text-sky-400" /> Dirección técnica matriculada
        </span>
        <span class="inline-flex items-center gap-2">
          <Icon name="check" class="size-4 text-sky-400" /> Instrumental calibrado y certificado
        </span>
        <a href={whatsappHref()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-white">
          <Icon name="phone" class="size-4 text-sky-400" /> Respuesta en el día
        </a>
      </p>
    </div>

    <div>
      <figure class="relative">
        <div class="relative overflow-hidden rounded-brand border border-white/15">
          <Image
            src={portada}
            alt="Técnico realizando un trabajo en altura sobre un aerogenerador"
            widths={[480, 582]}
            sizes="(min-width: 1024px) 480px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="absolute inset-0 bg-linear-to-t from-navy-900 via-navy-900/40 to-transparent" aria-hidden="true"></div>

          <dl class="absolute inset-x-0 bottom-0 flex p-5 sm:p-6">
            {
              stats.map((s, i) => (
                <div class={`flex-1 ${i > 0 ? 'border-l border-white/20 pl-4' : ''}`}>
                  <dt class="sr-only">{s.label}</dt>
                  <dd>
                    <b class="block font-display text-2xl text-sky-400">{s.value}</b>
                    <span class="text-[12px] leading-tight text-[#CFE3F0]">{s.label}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="absolute top-4 left-4 rounded-brand bg-white p-3 shadow-2xl lg:-top-7 lg:-left-7 lg:p-3.5">
          <Image src={logo} alt={site.name} width={220} loading="eager" class="h-auto w-20 lg:w-24" />
        </div>
      </figure>

      <p class="mt-6 border-l-2 border-sky-400/60 pl-4 text-[13.5px] text-[#B9D3E5]">
        Dirección técnica a cargo de un Licenciado en Higiene y Seguridad con más de dos décadas en
        proyectos de generación eléctrica e industrias de alta complejidad.
      </p>
    </div>
  </div>
</section>
