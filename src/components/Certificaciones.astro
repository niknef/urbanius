---
const normas = [
  { code: 'ISO 9001', label: 'Sistema de gestión de calidad' },
  { code: 'ISO 14001', label: 'Sistemas de gestión ambiental' },
  { code: 'ISO 45001', label: 'Sistemas de gestión de la seguridad y salud en el trabajo' },
];
---

<div class="bg-navy-900 py-12">
  <div class="wrap grid items-center gap-7 lg:grid-cols-[.7fr_2fr] lg:gap-10">
    <span class="max-w-60 text-[13px] font-medium text-[#B9D3E5]">
      Sistemas de gestión que implementamos y auditamos
    </span>
    <ul class="grid gap-3.5 sm:grid-cols-3">
      {
        normas.map((n) => (
          <li class="flex flex-col gap-1.5 rounded-brand border border-white/15 px-5 py-4 transition-colors hover:border-sky-400/60">
            <span class="font-display text-[17px] font-semibold text-white">{n.code}</span>
            <span class="text-[12.5px] leading-snug text-[#8FAEC2]">{n.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
