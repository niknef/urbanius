---
interface Props {
  kicker: string;
  title: string;
  text?: string;
  class?: string;
}
const { kicker, title, text, class: className = '' } = Astro.props;
---

<div class={`mb-12 max-w-2xl ${className}`}>
  <span class="kicker">{kicker}</span>
  <h2 class="text-[clamp(1.55rem,3.4vw,2rem)] leading-tight">{title}</h2>
  {text && <p class="mt-3.5 text-[15.5px] text-ink-soft">{text}</p>}
</div>
