---
import { site, contact, nav } from '../data/site';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo-urbanus.png';

const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-navy-900 py-16 text-[#B9D3E5]">
  <div class="wrap">
    <div class="grid gap-10 border-b border-white/10 pb-11 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <span class="mb-5 grid size-24 place-items-center rounded-brand bg-white p-2.5">
          <Image src={logo} alt={site.name} width={180} class="size-full object-contain" />
        </span>
        <p class="max-w-70 text-[13.5px] text-[#8FAEC2]">
          Consultoría integral en Calidad, Higiene, Seguridad y Medio Ambiente para empresas e
          industrias de alta complejidad.
        </p>
      </div>

      <div>
        <p class="mb-4 text-[13px] font-semibold tracking-wide text-white">Dirección técnica</p>
        <p class="mb-3 flex gap-2.5 text-[13.5px]">
          <Icon name="user" class="mt-0.5 size-4 shrink-0 text-sky-400" />
          {contact.lead.name}
        </p>
        <a href={`tel:${contact.phoneE164}`} class="mb-3 flex gap-2.5 text-[13.5px] hover:text-white">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-sky-400" />
          {contact.phoneDisplay}
        </a>
      </div>

      <div>
        <p class="mb-4 text-[13px] font-semibold tracking-wide text-white">Contacto</p>
        <a href={`mailto:${contact.email}`} class="mb-3 flex gap-2.5 text-[13.5px] hover:text-white">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-sky-400" />
          {contact.email}
        </a>
        <p class="mb-3 flex gap-2.5 text-[13.5px]">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-sky-400" />
          {contact.address.display}
        </p>
      </div>

      <div>
        <p class="mb-4 text-[13px] font-semibold tracking-wide text-white">Secciones</p>
        <ul class="grid gap-2.5 text-[13.5px]">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap justify-between gap-3 pt-6 text-[12.5px] text-[#6F92A9]">
      <span>© {year} {site.name}. Todos los derechos reservados.</span>
      <span>{contact.address.display} · Argentina</span>
    </div>
  </div>
</footer>
