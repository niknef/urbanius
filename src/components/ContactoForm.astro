---
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { contact, whatsappHref } from '../data/site';
---

<section id="contacto-form" class="bg-sky-50 py-16 sm:py-22">
  <div class="wrap reveal">
    <div class="grid overflow-hidden border border-line bg-white lg:grid-cols-[.9fr_1.1fr]">
      <div class="flex flex-col justify-center bg-navy-800 p-8 text-white sm:p-12">
        <h2 class="mb-3.5 text-[clamp(1.4rem,3vw,1.75rem)] text-white">Envíenos su consulta</h2>
        <p class="mb-7 text-[14.5px] text-[#CFE3F0]">
          Cuéntenos qué necesita y un asesor técnico se comunica a la brevedad. Si prefiere, también
          puede escribirnos directo por WhatsApp.
        </p>

        <div class="grid gap-3.5 text-[13.5px] text-[#CFE3F0]">
          <a href={`tel:${contact.phoneE164}`} class="flex items-center gap-3 hover:text-white">
            <Icon name="phone" class="size-4 shrink-0 text-sky-400" />
            {contact.phoneDisplay}
          </a>
          <a href={`mailto:${contact.email}`} class="flex items-center gap-3 hover:text-white">
            <Icon name="mail" class="size-4 shrink-0 text-sky-400" />
            {contact.email}
          </a>
          <p class="flex items-center gap-3">
            <Icon name="pin" class="size-4 shrink-0 text-sky-400" />
            {contact.address.display}
          </p>
          <p class="flex items-center gap-3">
            <Icon name="clock" class="size-4 shrink-0 text-sky-400" />
            {contact.hours}
          </p>
        </div>

        <a
          href={whatsappHref()}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex w-fit items-center gap-2 rounded-brand border border-white/25 px-4 py-2.5 text-[13.5px] font-semibold text-white transition hover:border-white hover:bg-white/10"
        >
          Escribir por WhatsApp
        </a>
      </div>

      <div class="p-8 sm:p-12">
        <LeadForm variant="full" origen="formulario-pie" />
      </div>
    </div>
  </div>
</section>
